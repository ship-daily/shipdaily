# Copy to .env.local and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required to run locally.

# Postgres. Defaults match docker-compose.yml. Leave unset on Cloudflare, where the HYPERDRIVE binding is used.
# With Neon, `neon env pull` fills these in: DATABASE_URL is the pooled URL (app queries),
# DATABASE_URL_UNPOOLED the direct URL (migrations, and the one to give Hyperdrive).
DATABASE_URL=postgres://shipdaily:shipdaily@localhost:5432/shipdaily
DATABASE_URL_UNPOOLED=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional OAuth providers. Leave empty to disable.
# GitHub: https://github.com/settings/developers (callback: http://localhost:3000/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials (callback: http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (sign-in codes) through Resend: https://resend.com/api-keys
# Leave empty locally to print emails in the terminal instead.
RESEND_API_KEY=
EMAIL_FROM="ShipDaily <login@shipdaily.ai>"

# Anti-abuse thresholds and ranking weights live in private env vars on production
# and are intentionally not listed here. Code must fall back to safe defaults.
