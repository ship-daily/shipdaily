{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipdaily",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference binding used by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shipdaily"
    }
  ],
  "images": {
    // Image optimization for next/image. See https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      // Postgres connection pooling. Create one with:
      //   bunx wrangler hyperdrive create shipdaily --connection-string="postgres://..."
      // and paste its id here. Local dev uses localConnectionString (the docker-compose database).
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://shipdaily:shipdaily@localhost:5432/shipdaily"
    }
  ],
  "observability": {
    "enabled": true
  }
}
